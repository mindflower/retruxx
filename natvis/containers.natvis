<?xml version="1.0" encoding="utf-8"?> 
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<Type Name="oldstd::map&lt;*&gt;">
		<DisplayString>{{size = {_Mysize}}}</DisplayString>
		<Expand>
			<Item Name="[size]">_Mysize</Item>
			<Item Name="[comp]">comp</Item>
			<TreeItems>
				<Size>_Mysize</Size>
				<HeadPointer>_Myhead-&gt;_Parent</HeadPointer>
				<LeftPointer>_Left</LeftPointer>
				<RightPointer>_Right</RightPointer>
				<ValueNode Condition="!((bool)_Isnil)">_Myval</ValueNode>
			</TreeItems>
		</Expand>
	</Type>

	<Type Name="oldstd::vector&lt;*&gt;">
		<Intrinsic Name="size" Expression="(size_t)(_Mylast - _Myfirst)" />
		<Intrinsic Name="capacity" Expression="(size_t)(_Myend - _Myfirst)" />
		<DisplayString>{{ size={size()} }}</DisplayString>
		<Expand>
			<Item Name="[capacity]" ExcludeView="simple">capacity()</Item>
			<Item Name="[allocator]" ExcludeView="simple">_Alval</Item>
			<ArrayItems>
				<Size>size()</Size>
				<ValuePointer>_Myfirst</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>

	<Type Name="oldstd::basic_string&lt;char,*&gt;">
		<AlternativeType Name="std::basic_string&lt;char8_t,*&gt;" />

		<Intrinsic Name="size" Expression="_Mysize" />
		<Intrinsic Name="capacity" Expression="_Myres" />
		<!-- _BUF_SIZE = 16 / sizeof(char) &lt; 1 ? 1 : 16 / sizeof(char) == 16 -->
		<Intrinsic Name="bufSize" Expression="16" />
		<Intrinsic Name="isShortString" Expression="capacity() &lt; bufSize()" />
		<Intrinsic Name="isLongString" Expression="capacity() &gt;= bufSize()" />
		<DisplayString Condition="isShortString()">{_Bx._Buf,na}</DisplayString>
		<DisplayString Condition="isLongString()">{_Bx._Ptr,na}</DisplayString>
		<StringView Condition="isShortString()">_Bx._Buf,na</StringView>
		<StringView Condition="isLongString()">_Bx._Ptr,na</StringView>
		<Expand>
			<Item Name="[size]" ExcludeView="simple">size()</Item>
			<Item Name="[capacity]" ExcludeView="simple">capacity()</Item>
			<Item Name="[allocator]" ExcludeView="simple">_Alval</Item>
			<ArrayItems>
				<Size>_Mysize</Size>
				<ValuePointer Condition="isShortString()">_Bx._Buf</ValuePointer>
				<ValuePointer Condition="isLongString()">_Bx._Ptr</ValuePointer>
			</ArrayItems>
		</Expand>
	</Type>
</AutoVisualizer>